# Copy to .env.local (gitignored) and adjust as needed.

# Which Midnight network the frontend talks to. Defaults to 'preview' if unset.
VITE_NETWORK_ID=preprod

# Proving is delegated to the connected Lace wallet by default (no local
# proof server needed). Set to true only if you're running one yourself
# (see cli/proof-server-local.yml) and want to prove against it instead.
VITE_USE_LOCAL_PROOF_SERVER=false
